# Copy to terraform.tfvars and adjust. Never put AWS keys in this file -
# use `aws configure`, AWS_PROFILE or environment variables instead.
aws_region           = "ap-south-1"
use_localstack       = true
cluster_name         = "tripboard"
kubernetes_version   = "v1.33.1"
worker_count         = 2
vpc_cidr             = "10.30.0.0/16"
public_subnet_cidrs  = ["10.30.1.0/24", "10.30.2.0/24"]
private_subnet_cidrs = ["10.30.11.0/24", "10.30.12.0/24"]

# real AWS only:
# use_localstack = false
# create_eks     = true
