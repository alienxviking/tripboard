# Everything here is optional: the values below are the defaults you get with no .env at all.
#
#   docker compose:  cp .env.example .env
#                    docker compose --env-file .env -f docker/docker-compose.yml up --build
#   backend alone:   uvicorn reads these from the environment, or from application/backend/.env

# --- docker compose ------------------------------------------------------------
# password of the local postgres container; compose builds the backend's DATABASE_URL from it
POSTGRES_PASSWORD=tripboard-local

# --- backend (application/backend/app/config.py) --------------------------------
# SQLAlchemy URL. compose and the helm chart set their own; this one is for running
# uvicorn on your machine against a local postgres
DATABASE_URL=postgresql+psycopg://tripboard:tripboard@localhost:5432/tripboard
# returned by /health and /api/info; the Docker image sets it to the commit SHA at build time
APP_VERSION=dev
# returned by /api/info (local, docker-compose, prod, ...)
ENVIRONMENT=local
APP_NAME=TripBoard API
# JSON logs on stdout; DEBUG also logs the /health, /ready and /metrics requests
LOG_LEVEL=INFO

# --- frontend container (nginx) -------------------------------------------------
# where nginx proxies /api to; compose and the helm chart set it
# BACKEND_URL=http://backend:8000
