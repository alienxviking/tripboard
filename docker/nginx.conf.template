server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # resolve the backend name at request time (not only at startup), so nginx still starts
    # when the backend service / DNS is not ready yet. NGINX_LOCAL_RESOLVERS is filled in by the
    # image entrypoint from /etc/resolv.conf (docker DNS in compose, kube-dns in kubernetes).
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $backend ${BACKEND_URL};

    # API calls go to the backend (docker compose service / k8s service)
    location /api/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # single page app: unknown paths serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
